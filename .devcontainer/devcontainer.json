{
  "name": "R package",
  "image": "docker.io/baldikacti/caulobrowser-dev:latest",
  "workspaceFolder": "/workspace/caulobrowser",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/caulobrowser,type=bind",
  "remoteUser": "coder",
  "updateRemoteUserUID": false, // keep UID 1000 to match runAsUser
  // Mirror the cluster's restrictions locally
  "runArgs": ["--read-only", "--cap-drop=ALL", "--security-opt=no-new-privileges"],
  // Deps are in the image; this writes .rvenv/ and installs the package
  "postCreateCommand": "rig proj sync --frozen",
  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r",
        "Posit.air-vscode",
        "rust-lang.rust-analyzer"
      ]
    }
  }
}